{
  "name": "Jev Logs",
  "short_name": "jevlogs",
  "description": "Open-source TypeScript log triage with Jev and OpenTelemetry. Keep your logs. Spend on the signal.",
  "start_url": "/",
  "id": "/",
  "display": "browser",
  "lang": "en",
  "background_color": "#fbfaf5",
