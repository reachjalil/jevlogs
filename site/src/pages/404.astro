---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found. Jev Logs" description="This URL has no matching page." noindex>
  <section class="missing wrap">
    <img
      src="/images/introducing-jevlogs.jpg"
      width="480"
      height="480"
      alt=""
    />
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>That path is not on this site. Use the homepage or the guide.</p>
    <div class="actions">
      <a class="button" href="/">Home</a>
      <a class="text-link" href="/guide/">Guide</a>
    </div>
  </section>
</Base>
