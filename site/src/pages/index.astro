<script>
import { estimateSavings } from '../../../src/index';
const form = document.querySelector<HTMLFormElement>('#cost-form')!;
const money = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(n);
form.addEventListener('input', () => {
 if (!form.checkValidity()) { document.querySelector('#percent')!.textContent = 'Enter valid nonnegative values.'; return; }
 const entries = Object.fromEntries([...new FormData(form)].map(([k,v]) => [k, Number(v)]));
 const result = estimateSavings({ logs: entries.logs!, tokensPerLog: entries.tokensPerLog!, llmInputPerMillion: entries.llmInputPerMillion!, llmOutputPerMillion: entries.llmOutputPerMillion!, outputTokensPerLog: entries.outputTokensPerLog!, retainedFraction: entries.retainedPercent! / 100, jevInputPerMillion: entries.jevInputPerMillion!, questionTokensPerLog: entries.questionTokensPerLog! });
 document.querySelector('#saved')!.textContent = money(result.savings);
 document.querySelector('#percent')!.textContent = `${result.percent.toFixed(1)}% ${result.savings < 0 ? '(cost increase)' : 'less analysis spend'}`;
 document.querySelector('#baseline')!.textContent = money(result.baseline);
 document.querySelector('#with-jev')!.textContent = money(result.withJev);
 (document.querySelector('#jev-bar') as HTMLElement).style.width = `${Math.min(100, result.baseline ? result.withJev / result.baseline * 100 : 100)}%`;
});
form.dispatchEvent(new Event('input'));
document.querySelector('#run-demo')!.addEventListener('click', () => {
 document.querySelectorAll<HTMLElement>('.log-row').forEach(row => { row.querySelector('.score')!.textContent = row.dataset.value!; row.querySelector('small')!.textContent = row.dataset.route!; });
 document.querySelector('#demo-status')!.textContent = '4 logs preserved. 2 selected for deeper analysis.';
 document.querySelector('#run-demo')!.textContent = 'Run again ↗';
});
document.querySelector('#copy-code')!.addEventListener('click', async event => { const button = event.currentTarget as HTMLButtonElement; try { await navigator.clipboard.writeText(document.querySelector('#install-code')!.textContent!); button.textContent = 'Copied'; } catch { button.textContent = 'Select code to copy'; } });
</script>
</body></html>
