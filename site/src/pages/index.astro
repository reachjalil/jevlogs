---
import Base from '../layouts/Base.astro';

const repo = 'https://github.com/reachjalil/jevlogs';
const snippet = `import { JevLogExporter } from 'jevlogs';
import { BatchLogRecordProcessor } from
  '@opentelemetry/sdk-logs';

const processor = new BatchLogRecordProcessor({
  exporter: new JevLogExporter({
    exporter: yourExporter
  })
});
// Every log kept. Value + priority attached.`;

const logs = [
  {
    id: 'health',
    severity: 'INFO',
    title: 'GET /health → 200',
    detail: 'api-gateway · routine heartbeat',
    route: 'retain',
    value: 0,
  },
  {
    id: 'cache',
    severity: 'DEBUG',
    title: 'Cache hit: product:482',
    detail: 'catalog · expected operation',
    route: 'retain',
    value: 25,
  },
  {
    id: 'pay',
    severity: 'ERROR',
    title: 'Payment capture failed',
    detail: 'checkout · protected by severity',
    route: 'analyze',
    value: 100,
  },
  {
    id: 'pool',
    severity: 'WARN',
    title: 'Connection pool near capacity',
    detail: 'database · investigate degradation',
    route: 'analyze',
    value: 75,
  },
] as const;

---
<Base
  title="Jev Logs. Keep your logs. Spend on the signal."
  description="Open-source TypeScript log triage with Jev, Vercel AI SDK, and OpenTelemetry. Score diagnostic value before expensive LLM analysis."
  markdownHref="/index.md"
>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">Open source · OpenTelemetry · TypeScript</p>
      <h1>Keep your logs.<br />Spend on the <em>signal.</em></h1>
      <p class="lead">
        Score diagnostic value on OpenTelemetry logs before you send them to an expensive reasoning model.
        Every record stays in your archive. Analysis is recommended only for high-value, uncertain, or protected events.
      </p>
      <div class="actions">
        <a class="button" href="/guide/">Read the guide</a>
        <a class="text-link" href="#demo">Try a sample</a>
      </div>
      <div class="launch-row">
        <button class="npx" id="copy-npx" type="button" aria-label="Copy npx jevlogs">
          <span class="npx-prompt">$</span>
          <code>npx jevlogs</code>
          <span class="npx-copy">copy</span>
        </button>
        <p class="launch-note">v0.3.0 · MIT · npm install jevlogs</p>
      </div>
    </div>
    <figure class="hero-art">
      <img
        src="/jev.jpg"
        width="1300"
        height="722"
        alt="Jev Logs routing log records into a background bin and a signal bin."
        fetchpriority="high"
      />
      <figcaption>
        Background skips the analysis model. Signal is recommended for deeper analysis. Every record is kept.
      </figcaption>
    </figure>
  </section>

  <div class="wrap integrations">
    <span class="micro">Works&nbsp;with</span>
    <strong>OpenTelemetry</strong>
    <span aria-hidden="true">·</span>
    <strong>TypeSafe Jev</strong>
    <span aria-hidden="true">·</span>
    <strong>Vercel AI SDK</strong>
  </div>

  <section id="demo" class="wrap section sorter">
    <div class="section-heading">
      <p class="eyebrow">Sample routing</p>
      <h2>The same four logs as the CLI demo</h2>
      <p>
        Health checks go to <strong>background</strong> (keep, skip the analysis model).
        Failures go to <strong>signal</strong> (keep, send to analysis).
        Drag a record or tap a destination. These are the four sample logs from <code>npx jevlogs</code>.
      </p>
    </div>

    <div class="desk">
      <div class="desk-head">
        <img
          class="desk-face"
          src="/jev-portrait.jpg"
          width="720"
          height="641"
          alt=""
        />
        <p class="speech" id="jev-speech">Ready to score diagnostic value.</p>
      </div>
      <div class="inbox" id="inbox">
        <p class="inbox-label">Incoming logs</p>
          {logs.map((log) => (
            <article
              class="slip"
              draggable="true"
              data-id={log.id}
              data-route={log.route}
              data-value={String(log.value)}
            >
              <div class="slip-top">
                <span class:list={['severity', log.severity.toLowerCase()]}>{log.severity}</span>
                <span class="value" hidden></span>
              </div>
              <code>{log.title}</code>
              <small>{log.detail}</small>
              <div class="slip-actions">
                <button type="button" data-send="retain">background</button>
                <button type="button" data-send="analyze">signal</button>
              </div>
            </article>
          ))}
      </div>

      <div class="bins">
        <div class="bin bin-retain" data-bin="retain">
          <header>
            <span>background</span>
            <small>keep · skip LLM</small>
            <b class="bin-count" aria-live="polite">0</b>
          </header>
          <div class="pile" data-empty="Skip analysis"></div>
        </div>
        <div class="bin bin-analyze" data-bin="analyze">
          <header>
            <span>signal</span>
            <small>keep · send to analysis</small>
            <b class="bin-count" aria-live="polite">0</b>
          </header>
          <div class="pile" data-empty="Send to analysis"></div>
        </div>
      </div>

      <div class="desk-bar">
        <p id="sort-status">4 records. Drag, tap a destination, or run the sample.</p>
        <div class="desk-actions">
          <button type="button" class="button" id="jev-sort">Run sample</button>
          <button type="button" class="button-ghost" id="reset-sort">Reset</button>
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="wrap section">
    <div class="section-heading">
      <p class="eyebrow">How it works</p>
      <h2>Score first. Analyze second.</h2>
      <p>Jev Logs wraps the OpenTelemetry log exporter you already use. It attaches a diagnostic-value score, a priority, and a routing recommendation. Your archive exporter is unchanged.</p>
    </div>
    <div class="features">
      <article>
        <span class="number">01</span>
        <h3>Score every record</h3>
        <p>Each log gets a 0-100 diagnostic-value score, a priority, and an actionable probability from TypeSafe's Jev.</p>
      </article>
      <article>
        <span class="number">02</span>
        <h3>Keep uncertain and protected records</h3>
        <p>A record can skip analysis only when value is 25 or below, priority is low, and actionable probability is below retainBelow. Errors, protected records, and timeouts stay on the analysis path.</p>
      </article>
      <article>
        <span class="number">03</span>
        <h3>Route a separate analysis branch</h3>
        <p>Start in annotate mode so every record is exported with jev.* attributes. Use analysis-only mode on a second processor when you are ready to skip low-value LLM calls.</p>
      </article>
    </div>
  </section>

  <section class="why">
    <div class="wrap why-grid">
      <div>
        <p class="eyebrow">Model price</p>
        <h2>Typed routing at TypeSafe launch pricing</h2>
        <img
          class="why-mascot"
          src="/images/introducing-jevlogs.jpg"
          width="320"
          height="320"
          loading="lazy"
          decoding="async"
          alt=""
        />
      </div>
      <div>
        <div class="price">
          <strong>$0.042</strong>
          <span>per million input tokens<br />TypeSafe's published launch price</span>
        </div>
        <p>One request returns choices, rubric scores, and probabilities. A routing decision does not need a generated explanation.</p>
        <div class="why-details">
          <span><b>Parallel questions</b>Shared log context</span>
          <span><b>Free output</b>At TypeSafe launch pricing</span>
          <span><b>Uncertain answers</b>Stay eligible for analysis</span>
        </div>
        <p class="small">
          Vercel AI Gateway lists $0.04/M. Billing may differ. Jev is early access. Provider speed numbers are not Jev Logs benchmarks. Typed outputs can still be wrong.
          <a href="https://typesafe.ai/blog/introducing-system-one-models-and-jev" rel="noopener">TypeSafe announcement</a>
        </p>
      </div>
    </div>
  </section>

  <section id="savings" class="wrap section">
    <div class="section-heading">
      <p class="eyebrow">Cost estimate</p>
      <h2>Estimate analysis spend</h2>
      <p>This uses <code>estimateSavings()</code> from the package. It is an estimate, not a benchmark. Include errors, uncertain decisions, and failures in the fraction still sent to your LLM.</p>
    </div>
    <div class="calculator">
      <form id="cost-form" autocomplete="off">
        <fieldset>
          <legend>Your workload</legend>
          <label>Logs per month<input name="logs" type="number" min="0" max="1000000000000" value="1000000" required /></label>
          <label>Input tokens per log<input name="tokensPerLog" type="number" min="0" value="300" required /></label>
          <label>Output tokens per log<input name="outputTokensPerLog" type="number" min="0" value="50" required /></label>
          <label>Logs still analyzed · %<input name="retainedPercent" type="number" min="0" max="100" value="10" required /></label>
        </fieldset>
        <fieldset>
          <legend>Model prices</legend>
          <label>LLM input · $ / 1M tokens<input name="llmInputPerMillion" type="number" min="0" step="0.001" value="2" required /></label>
          <label>LLM output · $ / 1M tokens<input name="llmOutputPerMillion" type="number" min="0" step="0.001" value="12" required /></label>
          <label>Jev input · $ / 1M tokens<input name="jevInputPerMillion" type="number" min="0" step="0.001" value="0.042" required /></label>
          <label>Jev question overhead · tokens<input name="questionTokensPerLog" type="number" min="0" value="400" required /></label>
        </fieldset>
      </form>
      <div class="estimate" aria-live="polite">
        <p class="micro">Estimated monthly savings</p>
        <strong id="saved">$1,051</strong>
        <span id="percent">87.6% less analysis spend</span>
        <div class="cost-line"><span>Analyze everything</span><b id="baseline">$1,200.00</b></div>
        <div class="bar baseline-bar"></div>
        <div class="cost-line"><span>Jev + selected LLM calls</span><b id="with-jev">$149.40</b></div>
        <div class="bar jev-bar" id="jev-bar"></div>
        <p class="small">Includes Jev input and question overhead, plus selected LLM input and output. Excludes storage, ingestion, hosting, retries, discounts, and prompt caching. Assumes equal average log sizes; savings depend on your workload.</p>
      </div>
    </div>
  </section>

  <section class="wrap section install">
    <div>
      <p class="eyebrow">Install</p>
      <h2>Wrap the exporter you already have</h2>
      <p>Install with <code>npm install jevlogs</code>. <code>npx jevlogs</code> runs the offline demo. Add <code>jevlogs.config.json</code> and run <code>npx jevlogs --live</code> for a local OpenTelemetry receiver. Send OTLP HTTP/JSON, set <code>forwardUrl</code> for your collector, or wrap your existing exporter.</p>
      <a class="button" href="/guide/">Read the guide</a>
    </div>
    <div class="code-panel">
      <div class="code-heading"><span>telemetry.ts</span><button type="button" id="copy-code">Copy</button></div>
      <pre><code id="install-code">{snippet}</code></pre>
      <p class="small code-note">Node.js 22+ · AI SDK 7.0.105 · OTel SDK Logs 0.222.0</p>
    </div>
  </section>

  <section class="wrap closing">
    <img
      class="closing-banner"
      src="/banner.jpg"
      width="1800"
      height="600"
      loading="lazy"
      decoding="async"
      alt="Jev Logs. Keep your logs. Spend on the signal."
    />
    <p class="eyebrow">MIT licensed</p>
    <h2>Source is on GitHub</h2>
    <a class="button" href={repo} rel="noopener">View source</a>
    <p>Independent project. Not affiliated with TypeSafe, Vercel, or OpenTelemetry.</p>
  </section>
</Base>

<script>
import { estimateSavings } from '../../../src/index';

const form = document.querySelector<HTMLFormElement>('#cost-form')!;
const money = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(n);
form.addEventListener('input', () => {
  if (!form.checkValidity()) {
    document.querySelector('#percent')!.textContent = 'Enter valid nonnegative values.';
    return;
  }
  const entries = Object.fromEntries([...new FormData(form)].map(([k, v]) => [k, Number(v)]));
  const result = estimateSavings({
    logs: entries.logs!,
    tokensPerLog: entries.tokensPerLog!,
    llmInputPerMillion: entries.llmInputPerMillion!,
    llmOutputPerMillion: entries.llmOutputPerMillion!,
    outputTokensPerLog: entries.outputTokensPerLog!,
    retainedFraction: entries.retainedPercent! / 100,
    jevInputPerMillion: entries.jevInputPerMillion!,
    questionTokensPerLog: entries.questionTokensPerLog!,
  });
  document.querySelector('#saved')!.textContent = money(result.savings);
  document.querySelector('#percent')!.textContent = `${result.percent.toFixed(1)}% ${result.savings < 0 ? '(cost increase)' : 'less analysis spend'}`;
  document.querySelector('#baseline')!.textContent = money(result.baseline);
  document.querySelector('#with-jev')!.textContent = money(result.withJev);
  (document.querySelector('#jev-bar') as HTMLElement).style.width = `${Math.min(100, result.baseline ? result.withJev / result.baseline * 100 : 100)}%`;
});
form.dispatchEvent(new Event('input'));

const copy = async (button: HTMLButtonElement, text: string, done: string) => {
  const original = button.dataset.label ?? button.textContent!;
  button.dataset.label = original;
  try {
    await navigator.clipboard.writeText(text);
    button.textContent = done;
  } catch {
    button.textContent = 'Select to copy';
  }
  window.setTimeout(() => { button.textContent = button.dataset.label!; }, 1600);
};

document.querySelector('#copy-code')!.addEventListener('click', event => {
  copy(event.currentTarget as HTMLButtonElement, document.querySelector('#install-code')!.textContent!, 'Copied');
});
document.querySelector('#copy-npx')!.addEventListener('click', async () => {
  const label = document.querySelector<HTMLElement>('#copy-npx .npx-copy')!;
  try {
    await navigator.clipboard.writeText('npx jevlogs');
    label.textContent = 'copied';
  } catch {
    label.textContent = 'select';
  }
  window.setTimeout(() => { label.textContent = 'copy'; }, 1600);
});

const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const inbox = document.querySelector('#inbox')!;
const slips = [...document.querySelectorAll<HTMLElement>('.slip')];
const statusEl = document.querySelector('#sort-status')!;
const speechEl = document.querySelector('#jev-speech')!;
const jevBtn = document.querySelector<HTMLButtonElement>('#jev-sort')!;
const resetBtn = document.querySelector('#reset-sort')!;
let busy = false;
let runId = 0;
let dragging: HTMLElement | null = null;

const pause = (ms: number) => reduced ? Promise.resolve() : new Promise(resolve => setTimeout(resolve, ms));
const placedCount = () => slips.filter(slip => slip.classList.contains('placed')).length;
const say = (text: string) => { speechEl.textContent = text; };
const updateCounts = () => {
  for (const bin of document.querySelectorAll('.bin')) {
    const count = bin.querySelector('.bin-count');
    if (count) count.textContent = String(bin.querySelectorAll('.slip').length);
  }
};

const valueOf = (slip: HTMLElement) => {
  const value = slip.querySelector<HTMLElement>('.value')!;
  value.hidden = false;
  value.textContent = slip.dataset.value ?? '';
  slip.classList.add('revealed');
};

const returnToInbox = () => {
  for (const slip of slips) {
    slip.classList.remove('placed', 'revealed', 'match', 'miss', 'dragging');
    const value = slip.querySelector<HTMLElement>('.value')!;
    value.hidden = true;
    value.textContent = '';
    inbox.append(slip);
  }
  updateCounts();
};

const grade = () => {
  let matches = 0;
  for (const slip of slips) {
    const got = slip.parentElement?.closest('.bin')?.getAttribute('data-bin');
    const ok = got === slip.dataset.route;
    if (ok) matches += 1;
    slip.classList.toggle('match', Boolean(ok));
    slip.classList.toggle('miss', !ok);
    valueOf(slip);
  }
  return matches;
};

const finish = (kind: 'user' | 'jev') => {
  const matches = grade();
  if (kind === 'jev') {
    say('4 kept. 2 recommended for analysis.');
    statusEl.textContent = '4 kept. 2 routed to signal. Same answers as the CLI demo.';
  } else if (matches === 4) {
    say('Your routing matched the sample.');
    statusEl.textContent = 'Match. 2 in signal, 2 in background.';
  } else {
    say(`${matches}/4 matched the sample. Errors stay in signal.`);
    statusEl.textContent = `${matches}/4 matched the sample. Misses are marked. Reset to try again.`;
  }
};

const place = (slip: HTMLElement, route: string, fromJev = false) => {
  const pile = document.querySelector(`[data-bin="${route}"] .pile`);
  if (!pile || (busy && !fromJev)) return;
  slip.classList.add('placed');
  pile.append(slip);
  const bin = pile.closest('.bin');
  bin?.classList.add('got');
  window.setTimeout(() => bin?.classList.remove('got'), 380);
  updateCounts();
  say(route === 'analyze' ? 'Routed to signal.' : 'Routed to background.');
  if (!fromJev && placedCount() === slips.length) finish('user');
  else if (placedCount() < slips.length) statusEl.textContent = `${slips.length - placedCount()} remaining.`;
};

jevBtn.addEventListener('click', async () => {
  if (busy) return;
  const id = ++runId;
  busy = true;
  jevBtn.disabled = true;
  returnToInbox();
  say('Scoring diagnostic value.');
  statusEl.textContent = 'Scoring. Every record is kept. Signal is recommended for analysis.';
  for (const [index, slip] of slips.entries()) {
    await pause(280);
    if (id !== runId) return;
    statusEl.textContent = `Scoring ${index + 1} of ${slips.length}…`;
    place(slip, slip.dataset.route!, true);
    valueOf(slip);
  }
  if (id !== runId) return;
  finish('jev');
  jevBtn.disabled = false;
  jevBtn.textContent = 'Run again';
  busy = false;
});

resetBtn.addEventListener('click', () => {
  runId += 1;
  busy = false;
  jevBtn.disabled = false;
  jevBtn.textContent = 'Run sample';
  returnToInbox();
  say('Ready to score diagnostic value.');
  statusEl.textContent = '4 records. Drag, tap a destination, or run the sample.';
});

for (const slip of slips) {
  slip.addEventListener('dragstart', event => {
    if (busy) { event.preventDefault(); return; }
    dragging = slip;
    slip.classList.add('dragging');
    event.dataTransfer?.setData('text/plain', slip.dataset.id ?? '');
    event.dataTransfer!.effectAllowed = 'move';
  });
  slip.addEventListener('dragend', () => {
    slip.classList.remove('dragging');
    dragging = null;
    document.querySelectorAll('.bin, .inbox').forEach(node => node.classList.remove('over'));
  });
  slip.querySelectorAll<HTMLButtonElement>('[data-send]').forEach(button => {
    button.addEventListener('click', () => {
      if (busy) return;
      place(slip, button.dataset.send!);
    });
  });
}

for (const bin of document.querySelectorAll<HTMLElement>('.bin')) {
  bin.addEventListener('dragover', event => {
    event.preventDefault();
    if (!busy) bin.classList.add('over');
  });
  bin.addEventListener('dragleave', () => bin.classList.remove('over'));
  bin.addEventListener('drop', event => {
    event.preventDefault();
    bin.classList.remove('over');
    if (dragging && !busy) place(dragging, bin.dataset.bin!);
  });
}

inbox.addEventListener('dragover', event => {
  event.preventDefault();
  inbox.classList.add('over');
});
inbox.addEventListener('dragleave', () => inbox.classList.remove('over'));
inbox.addEventListener('drop', event => {
  event.preventDefault();
  inbox.classList.remove('over');
  if (!dragging || busy) return;
  dragging.classList.remove('placed', 'revealed', 'match', 'miss');
  const value = dragging.querySelector<HTMLElement>('.value')!;
  value.hidden = true;
  inbox.append(dragging);
  updateCounts();
  statusEl.textContent = `${slips.length - placedCount()} remaining.`;
});
</script>
