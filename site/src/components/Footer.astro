    <span>v{siteMeta.version} · MIT · Built for the signal.</span>
    <a href="/guide/">Docs</a>
    <a href="/llms.txt">llms.txt</a>
    <a href={siteMeta.npm} rel="noopener">npm</a>
    <a href={siteMeta.repo} rel="noopener">GitHub ↗</a>
  </div>
</footer>
