---
import Logo from './Logo.astro';
const repo = 'https://github.com/reachjalil/jevlogs';
const path = Astro.url.pathname;
const onGuide = path.startsWith('/guide');
---
<header class="site-header">
  <div class="wrap header">
    <a class="brand" href="/" aria-label="Jev Logs home">
      <span class="mark" aria-hidden="true">
        <Logo />
      </span>
      <span class="wordmark">Jev Logs</span>
    </a>
    <nav aria-label="Main navigation">
      <a class="nav-compact" href="/#demo">Demo</a>
      <a class="nav-optional" href="/#how">How it works</a>
      <a class="nav-compact" href="/#savings">Estimate</a>
      <a href="/guide/" aria-current={onGuide ? 'page' : undefined}>Guide</a>
    </nav>
    <a class="github" href={repo} rel="noopener noreferrer">GitHub</a>
  </div>
</header>
