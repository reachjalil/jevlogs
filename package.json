{
  "name": "jevlogs",
  "version": "0.5.0",
  "description": "Confidence-aware log triage with Jev and OpenTelemetry",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build",
    "site:build": "pnpm --filter jevlogs-site build",
    "deploy": "pnpm site:build && wrangler deploy",
    "check:examples": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck examples/telemetry.ts examples/otlp-client.ts"
  },
  "dependencies": {
    "ai": "7.0.105"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-logs": "0.222.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@10.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reachjalil/jevlogs.git"
  },
  "homepage": "https://jevlogs.com",
  "bugs": {
    "url": "https://github.com/reachjalil/jevlogs/issues"
  },
  "bin": {
    "jevlogs": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-logs": {
      "optional": true
    }
  },
  "keywords": [
    "jev",
    "logs",
    "opentelemetry",
    "observability",
    "cli",
    "ai-sdk"
  ]
}
